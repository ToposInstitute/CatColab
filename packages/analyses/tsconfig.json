{
    "extends": "@tsconfig/strictest/tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2023", "DOM"]
    },
    "include": ["src/**/*.ts"]
}
