model SigMonoid := [
  M : Object,
  op : Multihom[[M, M], M],
  unit : Multihom[[], M]
]
#/ declared: SigMonoid

model SigRig := [
  R : Object,
  Add : SigMonoid & [ .M := R ],
  Mul : SigMonoid & [ .M := R ]
]
#/ declared: SigRig

instance Z2 : SigMonoid := [
    M := [x],
    op([x,x]) := unit([]),
    op([x,unit([])]) := x,
    op([unit([]),x]) := x
]
#/ declared: Z2
#/ instance generation failed: instance generation only supports discrete double theories

instance Z2freeZ2 : SigMonoid := [
    a : Z2,
    b : Z2
]
#/ declared: Z2freeZ2
#/ instance generation failed: instance generation only supports discrete double theories

instance klein : SigMonoid := [
    p : Z2freeZ2,
    op([p.a.x,p.b.x]) := op([p.b.x,p.a.x]),
    op([op([p.a.x,p.b.x]),op([p.a.x,p.b.x])]) := unit([])
]
#/ declared: klein
#/ instance generation failed: instance generation only supports discrete double theories

