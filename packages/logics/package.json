    "private": true,
    "license": "MIT",
    "type": "module",
    "exports": {
        "./*": "./src/*.ts"
    },
    "scripts": {
        "format": "oxfmt .",
        "lint": "oxlint --fix && oxfmt .",
        "test": "vitest run",
