        "catcolab-document-types": "link:../document-types/pkg",
        "happy-dom": "^20.0.0",
        "typescript": "^6.0.3",
        "vite": "^7.2.2",
        "vite-plugin-wasm": "^3.5.0",
        "vitest": "^4.0.8"
    }
