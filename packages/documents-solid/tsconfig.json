{
    "extends": "@tsconfig/strictest/tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
