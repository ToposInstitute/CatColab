{
    "extends": ["./tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
    "compilerOptions": {
        "noEmit": true,
        "types": ["node", "vite/client"],
        "noPropertyAccessFromIndexSignature": false,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "paths": {
            "catcolab-document-methods": ["../document-methods/src/index.ts"]
        }
    },
    "include": ["vite.config.ts", "vitest.db-dump.config.ts", "test/**/*.ts", "test/**/*.tsx"],
    "exclude": [
        "test/datascript-demo.test.ts",
        "test/petri_net_editor_comparison.test.tsx",
        "test/table-layout.test.ts"
    ]
}
